# Choix du provider live : auto | anthropic | openai
CREWDESK_AI_PROVIDER=auto

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# GPT / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optionnel : un seul modèle override pour le provider actif.
# CREWDESK_MODEL=

# Outils agents
CREWDESK_ALLOW_COMMANDS=0
CREWDESK_WEB_TOOLS=1
# CREWDESK_WORKSPACE=/tmp/CrewDesk-Projets

# Optionnel : tarification OpenAI pour le compteur coût ($ / million tokens).
# OPENAI_INPUT_USD_PER_MTOK=0
# OPENAI_OUTPUT_USD_PER_MTOK=0
